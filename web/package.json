{
  "name": "find-yourself-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Find Yourself React + TypeScript + Vite PWA frontend (Web slice). Talks only to the real backend API per FROZEN_CONTRACT v1.0.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
