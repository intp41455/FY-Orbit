// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DslDiagnostics 视觉快照基线（P12） > 通过态面板（0 条诊断）的渲染 HTML 与基线一致 1`] = `"<div class="fy-ir-diagnostics" data-testid="dsl-ir-diagnostics"><span class="badge accent" data-testid="dsl-ir-count">0</span> <span class="muted">类型校验通过（IR 0 条诊断）</span></div>"`;

exports[`DslDiagnostics 视觉快照基线（P12） > 错误态面板（2 条诊断）的渲染 HTML 与基线一致 1`] = `"<div class="fy-ir-diagnostics fy-ir-invalid" data-testid="dsl-ir-diagnostics" role="alert"><span class="badge danger" data-testid="dsl-ir-count">2</span> <strong>类型诊断（一次全量，共 2 条）</strong><ul class="fy-ir-list"><li class="fy-ir-item" data-testid="dsl-ir-item" title="string_type: Input should be a valid string"><code>string_type</code> @ <code>a</code> · 字段 <code>params.op</code><span class="fy-ir-message"> — Input should be a valid string</span></li><li class="fy-ir-item" data-testid="dsl-ir-item" title="missing: Field required"><code>missing</code> @ <code>b</code> · 字段 <code>params.field</code><span class="fy-ir-message"> — Field required</span></li></ul></div>"`;

exports[`PreviewChart 视觉快照基线（P12） > bar 图表的渲染 HTML 与基线一致 1`] = `"<div class="preview-chart" data-testid="wb-preview-chart"><svg data-testid="wb-preview-chart-svg" viewBox="0 0 320 200" role="img" aria-label="图表：演练成绩，共 2 个数据点"><g data-testid="chart-bar"><rect x="38" y="34" width="118" height="132" fill="var(--ui-sky-700)"></rect><rect x="164" y="41.33333333333334" width="118" height="124.66666666666666" fill="var(--ui-st-external)"></rect><text x="97" y="178" font-size="9" text-anchor="middle">张三</text><text x="223" y="178" font-size="9" text-anchor="middle">李四</text></g></svg><div class="muted small" data-testid="wb-preview-chart-meta">演练成绩 · bar · 2 点</div></div>"`;

exports[`PreviewChart 视觉快照基线（P12） > line 图表的渲染 HTML 与基线一致 1`] = `"<div class="preview-chart" data-testid="wb-preview-chart"><svg data-testid="wb-preview-chart-svg" viewBox="0 0 320 200" role="img" aria-label="图表：line，共 2 个数据点"><g data-testid="chart-line"><polyline points="34,122 286,34" fill="none" stroke="var(--ui-sky-700)" stroke-width="2"></polyline><circle cx="34" cy="122" r="3" fill="var(--ui-sky-700)"></circle><circle cx="286" cy="34" r="3" fill="var(--ui-sky-700)"></circle><text x="34" y="178" font-size="9" text-anchor="middle">a</text><text x="286" y="178" font-size="9" text-anchor="middle">b</text></g></svg><div class="muted small" data-testid="wb-preview-chart-meta">(无标题) · line · 2 点</div></div>"`;
