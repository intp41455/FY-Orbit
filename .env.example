# ============================================================================
# Find Yourself - 本地开发环境示例
# 用法：复制为 .env 后按需修改；.env 已在 .gitignore 中，绝不提交真实密钥。
# 本文件只放占位/安全默认值，不包含任何可用的真实凭据。
# 生成随机密钥示例（不要把输出提交到仓库）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# 运行环境：local | test | production。生产会强制要求 OIDC/HTTPS/Postgres。
FY_ENVIRONMENT=local

# ---- 数据库（仅本地回环暴露）---------------------------------------------
FY_POSTGRES_USER=fy
FY_POSTGRES_PASSWORD=replace-with-local-dev-password-only
FY_POSTGRES_DB=findyourself

# ---- Temporal -------------------------------------------------------------
FY_TEMPORAL_NAMESPACE=default
FY_TEMPORAL_QUEUE=find-yourself

# ---- S3 兼容私有存储（MinIO，绝不公开 bucket）----------------------------
FY_MINIO_ROOT_USER=fy-minio
FY_MINIO_ROOT_PASSWORD=replace-with-minio-local-dev-password
FY_S3_BUCKET=find-yourself
FY_S3_REGION=us-east-1

# ---- 应用安全 -------------------------------------------------------------
# 必须 >=32 字符；本地 dev 也要用随机值，不要直接用本占位值跑生产。
FY_SESSION_SECRET=replace-me-with-at-least-32-random-characters-xxxxxxxx
# local token 仅在 local/test 且远端为 127.0.0.1 时有效；生产必须留空。
FY_LOCAL_TOKEN=
FY_PUBLIC_URL=http://127.0.0.1:8000

# ---- OIDC（生产必填，本地可留空）-----------------------------------------
FY_OIDC_ISSUER=
FY_OIDC_CLIENT_ID=
FY_OIDC_CLIENT_SECRET=
FY_OIDC_OWNER_SUB=

# ---- 模型网关（冷启动默认关闭，留空即不调用付费模型）---------------------
# 四个字段 Provider / Base URL / Key / 模型名。OpenAI 兼容端点示例：
#   FY_MODEL_PROVIDER=openai_compat
#   FY_MODEL_BASE_URL=https://your-endpoint/v1
#   FY_MODEL_API_KEY=
#   FY_MODEL_NAME=your-model-name
# 本地推理（无需密钥）：
#   FY_MODEL_PROVIDER=ollama
#   FY_MODEL_BASE_URL=http://127.0.0.1:11434/v1
#   FY_MODEL_NAME=qwen2.5:7b
FY_MODEL_PROVIDER=
FY_MODEL_BASE_URL=
FY_MODEL_API_KEY=
FY_MODEL_NAME=

# ⚠️ 坑 1：默认离线。缺省 True 时即使配好 Key，远程调用仍被离线门
# 明确拒绝（503 offline_mode_remote_blocked）。要用云端模型必须显式置 0；
# 纯本地 ollama 可保持 1（设计意图：未经授权不得向公网外传数据）。
FY_OFFLINE_MODE=1

# ⚠️ 坑 2：未知单价必须显式声明。模型不在内置价目表时，网关抛
# PriceUnknown 阻断调用（冻结契约：不得按零费用放行）。
# 单价必须按供应商真实报价填写，不得为跑通而填 0。
# 例：FY_MODEL_PRICE_OVERRIDES={"your-model": {"input_usd_per_1k": "0.0001", "output_usd_per_1k": "0.0004", "context_window": 128000}}
FY_MODEL_PRICE_OVERRIDES=

# ---- 图片生成通道（可选；留空则该能力诚实返回未配置，不伪造成功）---------
# 同样需要 FY_IMAGE_PRICE_USD 护栏，否则拒绝调用。
FY_IMAGE_BASE_URL=
FY_IMAGE_MODEL=
FY_IMAGE_API_KEY=
FY_IMAGE_PRICE_USD=

# ---- 监控（monitoring profile）-------------------------------------------
FY_GRAFANA_USER=admin
FY_GRAFANA_PASSWORD=replace-with-local-grafana-password
