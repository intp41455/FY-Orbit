# ============================================================================
# Find Yourself - 本地开发环境示例
# 用法：复制为 .env 后按需修改；.env 已在 .gitignore 中，绝不提交真实密钥。
# 本文件只放占位/安全默认值，不包含任何可用的真实凭据。
# 生成随机密钥示例（不要把输出提交到仓库）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# 运行环境：local | test | production。生产会强制要求 OIDC/HTTPS/Postgres。
FY_ENVIRONMENT=local

# ---- 数据库（仅本地回环暴露）---------------------------------------------
FY_POSTGRES_USER=fy
FY_POSTGRES_PASSWORD=replace-with-local-dev-password-only
FY_POSTGRES_DB=findyourself

# ---- Temporal -------------------------------------------------------------
FY_TEMPORAL_NAMESPACE=default
FY_TEMPORAL_QUEUE=find-yourself

# ---- S3 兼容私有存储（MinIO，绝不公开 bucket）----------------------------
FY_MINIO_ROOT_USER=fy-minio
FY_MINIO_ROOT_PASSWORD=replace-with-minio-local-dev-password
FY_S3_BUCKET=find-yourself
FY_S3_REGION=us-east-1

# ---- 应用安全 -------------------------------------------------------------
# 必须 >=32 字符；本地 dev 也要用随机值，不要直接用本占位值跑生产。
FY_SESSION_SECRET=replace-me-with-at-least-32-random-characters-xxxxxxxx
# local token 仅在 local/test 且远端为 127.0.0.1 时有效；生产必须留空。
FY_LOCAL_TOKEN=
FY_PUBLIC_URL=http://127.0.0.1:8000

# ---- OIDC（生产必填，本地可留空）-----------------------------------------
FY_OIDC_ISSUER=
FY_OIDC_CLIENT_ID=
FY_OIDC_CLIENT_SECRET=
FY_OIDC_OWNER_SUB=

# ---- 模型网关（冷启动默认关闭，留空即不调用付费模型）---------------------
FY_MODEL_API_KEY=
FY_MODEL_BASE_URL=

# ---- 监控（monitoring profile）-------------------------------------------
FY_GRAFANA_USER=admin
FY_GRAFANA_PASSWORD=replace-with-local-grafana-password
