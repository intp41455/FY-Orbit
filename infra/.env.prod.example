# ==============================================================================
# Find Yourself - 生产环境变量示例模板 (.env.prod.example)
#
# 严禁将含有真实密钥的 .env.prod 提交至代码仓库！
# 生产部署时，复制本文件为 .env.prod 并填入各密钥的强随机真实值。
# ==============================================================================

# ---- 基础环境与网络 ----
FY_ENVIRONMENT=production
FY_PUBLIC_URL=https://api.yourdomain.com
FY_OWNER_ID=owner

# ---- 认证与安全 (生产强约束) ----
# 会话密钥：必须 >= 32 字符，建议用 openssl rand -hex 32 生成
FY_SESSION_SECRET=REPLACE_WITH_MIN_32_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET
# 本地 Token：生产环境强制禁止本地 dev token（必须留空）
FY_LOCAL_TOKEN=

# OIDC 单点登录 (生产必填)
FY_OIDC_ISSUER=https://auth.yourdomain.com
FY_OIDC_CLIENT_ID=find-yourself-client-id
FY_OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
FY_OIDC_OWNER_SUB=your-admin-user-subject-id

# ---- 数据库 (PostgreSQL + pgvector，生产强约束) ----
FY_DATABASE_URL=postgresql+psycopg://fy_prod:REPLACE_WITH_DB_PASSWORD@postgres:5432/findyourself
FY_POSTGRES_USER=fy_prod
FY_POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
FY_POSTGRES_DB=findyourself

# ---- 长线任务/工作流引擎 (Temporal，生产强约束) ----
FY_TEMPORAL_ADDRESS=temporal:7233
FY_TEMPORAL_NAMESPACE=default
FY_TEMPORAL_QUEUE=find-yourself

# ---- 对象存储 (S3 / MinIO，生产强约束) ----
FY_S3_ENDPOINT=http://minio:9000
FY_S3_BUCKET=find-yourself
FY_S3_REGION=us-east-1
FY_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
FY_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY

# MinIO 管理员账号密码（如果使用自带 MinIO 镜像）
FY_MINIO_ROOT_USER=REPLACE_WITH_S3_ACCESS_KEY
FY_MINIO_ROOT_PASSWORD=REPLACE_WITH_S3_SECRET_KEY

# ---- 本地目录与运行时 ----
FY_ARTIFACTS_PATH=/app/.runtime/artifacts
FY_ASSETS_DIR=/app/.runtime/assets

# ---- 模型网关 ----
FY_MODEL_PROVIDER=openai_compat
FY_MODEL_BASE_URL=https://api.openai.com/v1
FY_MODEL_API_KEY=REPLACE_WITH_MODEL_API_KEY
FY_MODEL_NAME=gpt-4o-mini
FY_IMAGE_PRICE_USD=0.04

# ---- 可观测性 (OpenTelemetry) ----
FY_OTLP_ENDPOINT=http://otel-collector:4318
